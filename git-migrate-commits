#!/bin/bash
# git-migrate-commits: Migrate selected commits to a target directory.
# It launches git-history-fzf to let the user pick multiple changes,
# and applies them to the target directory's git repository.
#
# Run the test script to verify changes:
#   ./git-migrate-commits_test.bash
#

set -e

export GIT_OPTIONAL_LOCKS=0

# Find the script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Source mutil.sh if available
if [[ -f "$SCRIPT_DIR/mutil.sh" ]]; then
  . "$SCRIPT_DIR/mutil.sh"
elif [[ -f "$SCRIPT_DIR/../mutil.sh" ]]; then
  . "$SCRIPT_DIR/../mutil.sh"
fi

print_help() {
  cat <<'EOF'
git-migrate-commits - Migrate selected commits to a target directory

Usage:
  git-migrate-commits [options] TARGET_DIR

Options:
  -h, --help             Show this help message.
  --[no-]autostash       Automatically stash and restore uncommitted changes in
                         the target repository (default: enabled).
  --bash-completion      Print bash completion script.

Examples:
  git-migrate-commits /path/to/target/repo
EOF
}

print_completion() {
  cat <<'EOF'
# Bash autocomplete script for git-migrate-commits.
# Generated by git-migrate-commits --bash-completion.

_git_migrate_commits() {
  local cur prev words cword
  if declare -F _get_comp_words_by_ref >/dev/null 2>&1; then
    _get_comp_words_by_ref -n =: cur prev words cword
  else
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words=("${COMP_WORDS[@]}")
    cword=$COMP_CWORD
  fi

  local opts="-h --help --autostash --no-autostash --bash-completion"

  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    return 0
  fi

  local start_idx=1
  if [[ "${words[0]}" == "git" ]]; then
    start_idx=2
  fi

  local num_args=0
  local i
  for ((i=start_idx; i<cword; i++)); do
    if [[ "${words[i]}" != -* ]]; then
      ((num_args++))
    fi
  done

  if (( num_args == 0 )); then
    COMPREPLY=( $(compgen -d -- "$cur") )
  fi
}

complete -o filenames -o bashdefault -F _git_migrate_commits git-migrate-commits
EOF
}

autostash=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    --autostash)
      autostash=1
      shift
      ;;
    --no-autostash)
      autostash=0
      shift
      ;;
    --bash-completion)
      print_completion
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      print_help
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

target_dir="$1"
if [[ -z "$target_dir" ]]; then
  echo "Error: Target directory is required." >&2
  print_help
  exit 1
fi

if [[ ! -d "$target_dir" ]]; then
  echo "Error: Target directory '$target_dir' does not exist." >&2
  exit 1
fi

# Find the actual git top directory of the target
target_git_root=$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null || true)
if [[ -z "$target_git_root" ]]; then
  echo "Error: Target directory '$target_dir' is not inside a Git repository." >&2
  exit 1
fi

if [[ -z "${GIT_HISTORY_FZF:-}" ]]; then
  GIT_HISTORY_FZF="$SCRIPT_DIR/git-history-fzf"
  if [[ ! -x "$GIT_HISTORY_FZF" ]]; then
    # Fallback to PATH if not in same directory (though it should be)
    GIT_HISTORY_FZF="git-history-fzf"
  fi
fi

# Launch git-history-fzf
if ! selected=$("$GIT_HISTORY_FZF"); then
  # User cancelled or error
  exit $?
fi

if [[ -z "$selected" ]]; then
  echo "No commits selected."
  exit 0
fi

# Extract hashes and reverse them
hashes=()
while read -r line; do
  # Strip ANSI escape codes (using bash expansion for ESC)
  clean_line=$(echo "$line" | sed $'s/\e\\[[0-9;]*m//g')
  # Get first word (hash)
  hash=$(echo "$clean_line" | awk '{print $1}')
  if [[ -n "$hash" ]]; then
    hashes+=("$hash")
  fi
done <<< "$selected"

# Reverse order (oldest first)
reversed_hashes=()
for ((i=${#hashes[@]}-1; i>=0; i--)); do
  reversed_hashes+=("${hashes[i]}")
done

echo "Migrating ${#reversed_hashes[@]} commits to $target_git_root..."

# Save uncommitted changes in the target repository before applying patches
has_autostash=0
if (( autostash )); then
  if [[ -n "$(git -C "$target_git_root" status --porcelain --untracked-files=no)" ]]; then
    echo "Target repository has uncommitted changes; creating autostash..."
    if git -C "$target_git_root" stash push -m "autostash: git-migrate-commits" >/dev/null; then
      has_autostash=1
    else
      echo "Error: Failed to create autostash in target repository '$target_git_root'." >&2
      exit 1
    fi
  fi
fi

# Generate patches and apply them
am_rc=0
(
  for hash in "${reversed_hashes[@]}"; do
    git format-patch -k --stdout -1 "$hash"
  done
) | (
  if type ee >/dev/null 2>&1; then
    ee git -C "$target_git_root" am -3 -k
  else
    git -C "$target_git_root" am -3 -k
  fi
) || am_rc=$?

if (( am_rc != 0 )); then
  if (( has_autostash )); then
    echo "Note: Uncommitted changes in target repository were saved to stash (autostash: git-migrate-commits)." >&2
    echo "After resolving or aborting the am session, restore your changes with:" >&2
    echo "  git -C \"$target_git_root\" stash pop" >&2
  fi
  exit $am_rc
fi

if (( has_autostash )); then
  echo "Restoring autostash in target repository..."
  if ! git -C "$target_git_root" stash pop; then
    echo "Warning: Restoring autostash resulted in merge conflicts." >&2
    echo "The stash entry has been preserved. Run 'git -C \"$target_git_root\" stash list' to see it." >&2
    exit 1
  fi
fi
