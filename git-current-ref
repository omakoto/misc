#!/bin/bash

# Print the current branch name (e.g. "main"), or the commit SHA if HEAD is detached.
# Simple script, no help needed.

set -e

export SUBDIRECTORY_OK=1
. "$(git --exec-path)/git-sh-setup"

require_work_tree_exists

cd_to_toplevel

# Ask git rather than reading $GIT_DIR/HEAD directly, so this works with any
# ref storage backend (e.g. with reftable, the HEAD file is only a stub).
git symbolic-ref --short -q HEAD || git rev-parse HEAD
