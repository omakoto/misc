#!/usr/bin/env python3
# -*- coding: utf-8 -*-
#
# switchbot: command line client for the SwitchBot Open API v1.1.
#
# Lists devices and scenes, shows device status and the commands a device
# accepts, sends device commands and executes scenes. Devices and scenes can be given by ID or by name.
#
# Credentials are read from the config file named by $ESP32_CONFIG_TOML (the
# same override file the ESP32 firmware projects bundle), using the keys
# `switchbot_token` and `switchbot_key`. The file is parsed with the firmware's
# simple `key = value` rules rather than as strict TOML, so that any file the
# firmware accepts works here too. Never put credentials in this script:
# this repository is public.
#
# API reference: https://github.com/OpenWonderLabs/SwitchBotAPI
#
# After modifying this script, run the tests:
#   python3 -m unittest ~/cbin/misc/switchbot_test.py

import argparse
import base64
import csv
import hashlib
import hmac
import json
import os
import sys
import time
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from typing import Any, NoReturn, Optional

API_BASE: str = "https://api.switch-bot.com/v1.1"
CONFIG_ENV: str = "ESP32_CONFIG_TOML"
TOKEN_KEY: str = "switchbot_token"
SECRET_KEY: str = "switchbot_key"
TIMEOUT_SECONDS: float = 15.0

# statusCode values returned in the response body. Anything other than
# STATUS_OK is an error, even when the HTTP status is 200.
STATUS_OK: int = 100
STATUS_MESSAGES: dict[int, str] = {
    151: "device type error",
    152: "device not found",
    160: "command is not supported by this device",
    161: "device offline",
    171: "hub device offline",
    190: "device internal error (often an invalid parameter or command)",
}

EPILOG: str = f"""\
Credentials:
  Read from the config file named by ${CONFIG_ENV} (or --config), using the
  keys `{TOKEN_KEY}` and `{SECRET_KEY}`. Get them from the SwitchBot app:
  Profile > Preferences > tap "App Version" 10 times > Developer Options.

DEVICE and SCENE may be an ID, an exact name (case-insensitive), or a unique
part of a name.

Examples:
  switchbot devices                     # List devices and IR remotes
  switchbot scenes                      # List manual scenes
  switchbot status "Living Bot"         # Show a device's status
  switchbot status C271111EC0AB --json  # Raw JSON status
  switchbot devices --csv > devices.csv # CSV (or --tsv) for spreadsheets/scripts
  switchbot commands "Living Bot"       # Show the commands a device accepts
  switchbot cmd "Living Bot" press      # Press a Bot
  switchbot cmd Light turnOff
  switchbot cmd Curtain setPosition 0,ff,80
  switchbot cmd TV MyButton --customize # IR remote custom button
  switchbot scene "Good night"          # Execute a scene
"""


class SwitchBotError(Exception):
    pass


@dataclass
class Item:
    """A device, IR remote or scene, reduced to what name lookup and listing need."""
    id: str
    name: str
    kind: str
    hub: str = ""
    # For IR remotes, the appliance type (e.g. "TV"); `kind` then carries an "IR " prefix.
    remote_type: Optional[str] = None


def die(message: str) -> NoReturn:
    print(f"switchbot: {message}", file=sys.stderr)
    sys.exit(1)


def parse_config(text: str) -> dict[str, str]:
    """Parses `key = value` lines the same way the ESP32 firmware's ConfigManager does.

    Values may be quoted. Unquoted values may have a trailing `# comment`.
    Lines starting with `#` and lines without `=` are ignored. Later keys win.
    """
    config: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = (part.strip() for part in line.split("=", 1))
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        else:
            val = val.split("#", 1)[0].strip()
        if key:
            config[key] = val
    return config


def load_credentials(path: Optional[str]) -> tuple[str, str]:
    if not path:
        path = os.environ.get(CONFIG_ENV, "")
    if not path:
        raise SwitchBotError(f"${CONFIG_ENV} is not set; use --config to specify the config file")
    try:
        with open(path, encoding="utf-8") as f:
            config = parse_config(f.read())
    except OSError as e:
        raise SwitchBotError(f"cannot read {path}: {e.strerror}")

    token = config.get(TOKEN_KEY, "")
    secret = config.get(SECRET_KEY, "")
    missing = [k for k, v in ((TOKEN_KEY, token), (SECRET_KEY, secret)) if not v]
    if missing:
        raise SwitchBotError(f"{path} has no {' or '.join(missing)}")
    return token, secret


def make_auth_headers(token: str, secret: str, t: Optional[str] = None,
                      nonce: Optional[str] = None) -> dict[str, str]:
    """Builds the signed headers the API requires on every request."""
    t = t if t is not None else str(int(time.time() * 1000))
    nonce = nonce if nonce is not None else str(uuid.uuid4())
    digest = hmac.new(secret.encode(), (token + t + nonce).encode(), hashlib.sha256).digest()
    return {
        "Authorization": token,
        "t": t,
        "nonce": nonce,
        "sign": base64.b64encode(digest).decode(),
        "Content-Type": "application/json; charset=utf8",
    }


class Client:
    def __init__(self, token: str, secret: str, verbose: bool = False) -> None:
        self.token = token
        self.secret = secret
        self.verbose = verbose

    def request(self, method: str, path: str, body: Optional[dict[str, Any]] = None) -> Any:
        """Sends a request and returns the response's `body` field."""
        url = API_BASE + path
        data = json.dumps(body).encode() if body is not None else None
        if self.verbose:
            # Headers are omitted on purpose: they contain the token.
            print(f"> {method} {url}", file=sys.stderr)
            if data is not None:
                print(f"> {data.decode()}", file=sys.stderr)

        req = urllib.request.Request(url, data=data, method=method,
                                     headers=make_auth_headers(self.token, self.secret))
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT_SECONDS) as res:
                raw = res.read()
        except urllib.error.HTTPError as e:
            with e:
                detail = e.read().decode(errors="replace").strip()
            if e.code == 401:
                raise SwitchBotError(f"HTTP 401: authentication failed; check {TOKEN_KEY} and {SECRET_KEY}")
            raise SwitchBotError(f"HTTP {e.code} {e.reason}" + (f": {detail}" if detail else ""))
        except urllib.error.URLError as e:
            raise SwitchBotError(f"cannot reach {API_BASE}: {e.reason}")
        except TimeoutError:
            raise SwitchBotError(f"timed out after {TIMEOUT_SECONDS:g}s")

        if self.verbose:
            print(f"< {raw.decode(errors='replace')}", file=sys.stderr)
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            raise SwitchBotError(f"invalid JSON response: {raw[:200]!r}")

        code = payload.get("statusCode")
        if code != STATUS_OK:
            message = payload.get("message") or STATUS_MESSAGES.get(code, "unknown error")
            hint = STATUS_MESSAGES.get(code)
            if hint and hint != message:
                message = f"{message} ({hint})"
            raise SwitchBotError(f"API error {code}: {message}")
        return payload.get("body")

    def devices(self) -> dict[str, Any]:
        return self.request("GET", "/devices")

    def scenes(self) -> list[dict[str, Any]]:
        return self.request("GET", "/scenes")

    def status(self, device_id: str) -> dict[str, Any]:
        return self.request("GET", f"/devices/{device_id}/status")

    def command(self, device_id: str, command: str, parameter: Any = "default",
                command_type: str = "command") -> Any:
        return self.request("POST", f"/devices/{device_id}/commands",
                            {"command": command, "parameter": parameter, "commandType": command_type})

    def execute_scene(self, scene_id: str) -> Any:
        return self.request("POST", f"/scenes/{scene_id}/execute")


def device_items(body: dict[str, Any]) -> list[Item]:
    items = [Item(d["deviceId"], d.get("deviceName", ""), d.get("deviceType", ""), d.get("hubDeviceId", ""))
             for d in body.get("deviceList") or []]
    items += [Item(d["deviceId"], d.get("deviceName", ""), f"IR {d.get('remoteType', '')}".strip(),
                   d.get("hubDeviceId", ""), d.get("remoteType", ""))
              for d in body.get("infraredRemoteList") or []]
    return items


def scene_items(body: list[dict[str, Any]]) -> list[Item]:
    return [Item(s["sceneId"], s.get("sceneName", ""), "scene") for s in body or []]


def resolve(query: str, items: list[Item], what: str) -> Item:
    """Finds an item by ID, then exact name, then unique name substring (case-insensitive)."""
    for item in items:
        if item.id == query:
            return item
    # Names set in the app can carry stray whitespace, so compare trimmed names.
    q = query.strip().casefold()
    for matcher in (lambda i: i.name.strip().casefold() == q, lambda i: q in i.name.casefold()):
        matches = [i for i in items if matcher(i)]
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            names = ", ".join(f"{i.name!r} ({i.id})" for i in matches)
            raise SwitchBotError(f"{what} {query!r} is ambiguous: {names}")
    raise SwitchBotError(f"no {what} matches {query!r}; run 'switchbot {what}s' to see the list")


def format_value(value: Any) -> str:
    """Renders a status value as a single cell; nested values are written as JSON."""
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False)
    return str(value)


def print_rows(header: list[str], rows: list[list[str]], fmt: str) -> None:
    """Prints a header and rows as an aligned table, TSV or CSV."""
    match fmt:
        case "csv":
            writer = csv.writer(sys.stdout, lineterminator="\n")
            writer.writerow(header)
            writer.writerows(rows)
        case "tsv":
            # TSV has no quoting, so tabs and newlines inside cells become spaces
            # to keep one record per line.
            for row in [header] + rows:
                print("\t".join(" ".join(cell.split("\t")).replace("\n", " ") for cell in row))
        case _:
            widths = [max(len(r[c]) for r in [header] + rows) for c in range(len(header))]
            for row in [header] + rows:
                print("  ".join(cell.ljust(w) for cell, w in zip(row, widths)).rstrip())


def print_items(items: list[Item], with_hub: bool, fmt: str) -> None:
    header = ["NAME", "TYPE", "ID"] + (["HUB"] if with_hub else [])
    rows = [[i.name, i.kind, i.id] + ([i.hub] if with_hub else []) for i in items]
    print_rows(header, rows, fmt)


def print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, ensure_ascii=False))


def device_commands(device: Item) -> tuple[list[tuple[str, str, str]], list[str]]:
    """Returns the documented (command, parameter, description) rows for a device, plus notes."""
    if device.remote_type is None:
        rows = DEVICE_COMMANDS.get(device.kind)
        if rows is None:
            return [], [f"No commands are documented for device type {device.kind!r}; "
                        "it may only support status, or be newer than this script's table."]
        return rows, []

    notes = ["Buttons added in the app can be sent by name with --customize "
             '(e.g. switchbot cmd DEVICE "Button name" --customize).']
    if device.remote_type == "Others":
        return [], ['"Others" remotes only have custom buttons. ' + notes[0]]
    # "DIY" remotes are learned button by button; their commands follow the base appliance type.
    base = device.remote_type.removeprefix("DIY ")
    if base != device.remote_type:
        notes.append("This is a learned (DIY) remote; buttons it hasn't learned won't work, "
                     "and learned buttons may need --customize.")
    return IR_COMMON_COMMANDS + IR_COMMANDS.get(base, []), notes


def parse_parameter(value: str, as_json: bool) -> Any:
    if not as_json:
        return value
    try:
        return json.loads(value)
    except json.JSONDecodeError as e:
        raise SwitchBotError(f"invalid JSON parameter: {e}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="switchbot",
        description="Command line client for the SwitchBot Open API v1.1.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-C", "--config", metavar="FILE",
                        help=f"credentials file (default: ${CONFIG_ENV})")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print requests and raw responses to stderr (credentials are not printed)")
    sub = parser.add_subparsers(dest="subcommand", metavar="SUBCOMMAND", required=True)

    def add_format_options(p: argparse.ArgumentParser) -> None:
        group = p.add_mutually_exclusive_group()
        group.add_argument("-j", "--json", dest="format", action="store_const", const="json",
                           help="print the raw JSON response body")
        group.add_argument("-t", "--tsv", dest="format", action="store_const", const="tsv",
                           help="print tab-separated values with a header row")
        group.add_argument("-c", "--csv", dest="format", action="store_const", const="csv",
                           help="print comma-separated values with a header row")
        p.set_defaults(format="text")

    p = sub.add_parser("devices", help="list devices and IR remotes")
    add_format_options(p)

    p = sub.add_parser("scenes", help="list manual scenes")
    add_format_options(p)

    p = sub.add_parser("status", help="show a device's status")
    p.add_argument("device", metavar="DEVICE", help="device ID or name")
    add_format_options(p)

    p = sub.add_parser(
        "commands", help="show the commands a device accepts",
        description="Show the commands a device accepts, from a table built into this script. "
                    "The table was generated from the API reference and may lag behind it; "
                    "see https://github.com/OpenWonderLabs/SwitchBotAPI for the latest.")
    p.add_argument("device", metavar="DEVICE", help="device ID or name")
    add_format_options(p)

    p = sub.add_parser(
        "cmd", help="send a command to a device",
        description="Send a command to a device. Command names are case-sensitive "
                    "(e.g. press, turnOn, turnOff, setPosition). See the API reference "
                    "for each device type's commands and parameters.")
    p.add_argument("device", metavar="DEVICE", help="device ID or name")
    p.add_argument("command", metavar="COMMAND", help="command name, or IR button name with --customize")
    p.add_argument("parameter", metavar="PARAMETER", nargs="?", default="default",
                   help='command parameter (default: "default")')
    p.add_argument("-u", "--customize", action="store_true",
                   help='send as commandType "customize" (custom IR remote buttons)')
    p.add_argument("-J", "--json-param", action="store_true",
                   help="parse PARAMETER as JSON instead of sending it as a string")

    p = sub.add_parser("scene", help="execute a manual scene")
    p.add_argument("scene", metavar="SCENE", help="scene ID or name")

    return parser


def run(args: argparse.Namespace) -> None:
    token, secret = load_credentials(args.config)
    client = Client(token, secret, verbose=args.verbose)

    match args.subcommand:
        case "devices":
            body = client.devices()
            if args.format == "json":
                print_json(body)
            else:
                print_items(device_items(body), with_hub=True, fmt=args.format)
        case "scenes":
            body = client.scenes()
            if args.format == "json":
                print_json(body)
            else:
                print_items(scene_items(body), with_hub=False, fmt=args.format)
        case "status":
            device = resolve(args.device, device_items(client.devices()), "device")
            body = client.status(device.id)
            if args.format == "json":
                print_json(body)
            elif args.format in ("tsv", "csv"):
                print_rows(["KEY", "VALUE"], [[k, format_value(v)] for k, v in body.items()], args.format)
            else:
                for key, value in body.items():
                    print(f"{key}: {value}")
        case "commands":
            device = resolve(args.device, device_items(client.devices()), "device")
            rows, notes = device_commands(device)
            if args.format == "json":
                print_json({
                    "deviceId": device.id, "deviceName": device.name, "type": device.kind,
                    "commands": [{"command": c, "parameter": p, "description": d} for c, p, d in rows],
                    "notes": notes,
                })
                return
            if args.format in ("tsv", "csv"):
                print_rows(["COMMAND", "PARAMETER", "DESCRIPTION"], [list(r) for r in rows], args.format)
                # Notes go to stderr so that stdout stays machine-readable.
                for note in notes:
                    print(f"switchbot: {note}", file=sys.stderr)
                return
            print(f"{device.name} ({device.kind}, {device.id})\n")
            if rows:
                print_rows(["COMMAND", "PARAMETER", "DESCRIPTION"], [list(r) for r in rows], "text")
                if notes:
                    print()
            for note in notes:
                print(f"Note: {note}")
        case "cmd":
            parameter = parse_parameter(args.parameter, args.json_param)
            device = resolve(args.device, device_items(client.devices()), "device")
            client.command(device.id, args.command, parameter,
                           "customize" if args.customize else "command")
            print(f"Sent {args.command} to {device.name} ({device.id})")
        case "scene":
            scene = resolve(args.scene, scene_items(client.scenes()), "scene")
            client.execute_scene(scene.id)
            print(f"Executed scene {scene.name} ({scene.id})")


def main() -> None:
    args = build_parser().parse_args()
    try:
        run(args)
    except SwitchBotError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


